import Proof.Quartic.StageGamma.PhysicalRead
import Proof.Gates.Cells.Loop
import Proof.Gates.CounterMachine.CellTablesBody1

set_option autoImplicit false
set_option linter.unusedSimpArgs false

namespace NearQuarticWires.StageGamma

open NearCubicGates.Close.Cells
open NearCubicGates.Close.CounterMachine.CellTablesProg

/-- `cor:conditional`, paper/paper.tex: append fixed
marker bits to the physical Gaussian-request stream. -/
def emitBits : List Bool → St VV MM
  | [] => skipS
  | bit :: bits => .seq (.op (.kem bit)) (emitBits bits)

/-- `cor:conditional`, paper/paper.tex: every marker
and ruler bit is emitted by an actual source-language operation. -/
theorem emitBits_spec (C : Ctx) (bits : List Bool) (a : DS VV MM)
    (hc : Cst a) (hroom : a.kin.length + bits.length ≤ C.Lk) :
    Hs C (emitBits bits) a (2 * bits.length + 1) (fun b =>
      b.kin = a.kin ++ bits ∧ SameN a b ∧ Cst b ∧ Fr a b [vJ]) := by
  induction bits generalizing a with
  | nil =>
    refine Hs.mono (skip_spec a) le_rfl ?_
    rintro b rfl
    refine ⟨by simp [DS.set], SameN.set _ _ _, ?_, Fr.set a _ (by simp)⟩
    exact Cst.of_fr (T := [vJ]) hc (Fr.set a 0 (by simp)) (by decide)
  | cons bit bits ih =>
    refine Hs.mono (Hs.seq (t2 := 2 * bits.length + 1)
      (hs_kem C bit a (by simp at hroom; omega)) (fun b hb => ?_))
      (by simp; omega) (fun _ h => h)
    subst hb
    have hc' : Cst { a with kin := a.kin ++ [bit] } := ⟨hc.z, hc.one, hc.two⟩
    refine Hs.mono (ih _ hc' (by simp; simp at hroom; omega)) le_rfl ?_
    rintro b ⟨hb, hs, hbc, hfr⟩
    exact ⟨by simpa using hb, ⟨hs.ip, hs.out, hs.ram, hs.rc, hs.kout, hs.kc⟩, hbc, hfr⟩

/-- `cor:conditional`, paper/paper.tex: concatenated
copies of a fixed marker block. -/
def bitBlocks (bits : List Bool) (n : ℕ) : List Bool := (List.replicate n bits).flatten

/-- `cor:conditional`, paper/paper.tex: one loop pass
appends exactly one marker block. -/
theorem bitBlocks_succ (bits : List Bool) (n : ℕ) :
    bitBlocks bits (n + 1) = bitBlocks bits n ++ bits := by
  rw [bitBlocks, List.replicate_add]
  simp [bitBlocks]

/-- `prop:time`, paper/paper.tex: ruler output length
is the actual number of emitted bits. -/
theorem bitBlocks_length (bits : List Bool) (n : ℕ) :
    (bitBlocks bits n).length = n * bits.length := by
  induction n with
  | zero => simp [bitBlocks]
  | succ n ih => rw [bitBlocks_succ]; simp [ih]; ring

/-- `cor:conditional`, paper/paper.tex: a fixed
counter variable for serializing Gaussian workspace rulers. -/
def emitIndex : Fin VV := ⟨50, by decide⟩

/-- `cor:conditional`, paper/paper.tex: physically
write the number of marker blocks held in a decoded binary variable. -/
def emitRepeated (count : Fin VV) (bits : List Bool) : St VV MM :=
  forS emitIndex count (emitBits bits)

/-- `cor:conditional` and `prop:time`, paper/paper.tex: serialized rulers are generated by a concrete loop whose
cost is linear in their actual lengths, rather than supplied for free. -/
theorem emitRepeated_spec (C : Ctx) (count : Fin VV) (hci : emitIndex ≠ count)
    (hcj : count ≠ vJ) (bits : List Bool) (a : DS VV MM) (hc : Cst a)
    (N : ℕ) (hcount : a.env count = N) (hN : N < 2 ^ C.Wd)
    (hroom : a.kin.length + N * bits.length ≤ C.Lk) :
    Hs C (emitRepeated count bits) a (N * (2 * bits.length + 5) + 4) (fun b =>
      b.kin = a.kin ++ bitBlocks bits N ∧ SameN a b ∧ Cst b ∧
      Fr a b [emitIndex, vJ]) := by
  let I : ℕ → DS VV MM → Prop := fun k b =>
    b.kin = a.kin ++ bitBlocks bits k ∧ SameN a b ∧ Cst b ∧ Fr a b [emitIndex, vJ]
  have hI : ∀ k b v, I k b → I k (b.set emitIndex v) := by
    intro k b v ⟨hb, hs, hbc, hfr⟩
    exact ⟨hb, hs.trans (SameN.set _ _ _),
      Cst.of_fr (T := [emitIndex]) hbc (Fr.set b v (by simp)) (by decide),
      hfr.trans (Fr.set b v (by simp))⟩
  have h0 : I 0 a := ⟨by simp [bitBlocks], SameN.refl _, hc, Fr.refl _ _⟩
  refine Hs.mono (forS_spec' emitIndex count hci (emitBits bits) a N hN I
    (2 * bits.length + 1) hI h0 hcount ?_) (by nlinarith) ?_
  · intro k hk b ⟨hb, hs, hbc, hfr⟩ hki hcn
    have hroom' : b.kin.length + bits.length ≤ C.Lk := by
      rw [hb, List.length_append, bitBlocks_length]
      have hm := Nat.mul_le_mul_right bits.length (show k + 1 ≤ N by omega)
      nlinarith
    refine Hs.mono (emitBits_spec C bits b hbc hroom') le_rfl ?_
    rintro e ⟨he, hes, hec, hefr⟩
    refine ⟨⟨?_, hs.trans hes, hec, hfr.trans (hefr.weaken (by simp))⟩, ?_, ?_⟩
    · rw [he, hb, bitBlocks_succ, List.append_assoc]
    · rw [hefr emitIndex (by decide)]
      exact hki
    · rw [hefr count (by simp [hcj])]
      exact hcn
  · rintro b ⟨hi, _, _⟩
    exact hi

end NearQuarticWires.StageGamma
